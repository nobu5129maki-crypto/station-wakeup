{
  "name": "station-wakeup",
  "private": true,
  "scripts": {
    "copy": "node scripts/copy-public.cjs",
    "build": "node scripts/copy-public.cjs",
    "test": "node scripts/test-speech-match.cjs",
    "icons": "python3 scripts/generate-launcher-icons.py",
    "verify:apk": "bash scripts/verify-launcher-apk.sh",
    "verify:zip": "python3 scripts/verify-official-zip.py",
    "zip:official": "python3 scripts/make-official-zip.py",
    "sync": "npm run copy && npx cap sync && node scripts/strip-apk-from-cap.js",
    "android:sync": "npm run copy && npx cap sync android && node scripts/strip-apk-from-cap.js",
    "android:open": "npx cap open android",
    "ios:sync": "npm run copy && npx cap sync ios && node scripts/strip-apk-from-cap.js",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.6.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
